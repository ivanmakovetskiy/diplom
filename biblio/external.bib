@article{da5c6981-883c-314e-91a7-25477f099152,
 ISSN = {07416261},
 URL = {http://www.jstor.org/stable/2555734},
 abstract = {We report experimental results on the role of preplay communication in a one-shot, symmetric battle of the sexes game. We conducted games in which there was no communication, and we studied the effects of three different communication structures: one-way communication with one round of messages and two-way communication with one round as well as three rounds of messages. With these messages, each player could indicate which action he planned to take. Communication significantly increased the frequency of equilibrium play. One-way communication was most effective in resolving the coordination problem. While there was more conflict with two-way communication, one round of communication helped to overcome some of the coordination problems, and three rounds of communication performed even better.},
 author = {Russell Cooper and Douglas V. DeJong and Robert Forsythe and Thomas W. Ross},
 journal = {The RAND Journal of Economics},
 number = {4},
 pages = {568--587},
 publisher = {[RAND Corporation, Wiley]},
 title = {Communication in the Battle of the Sexes Game: Some Experimental Results},
 urldate = {2024-02-10},
 volume = {20},
 year = {1989}
}

@article{kahn8519b346-8909-36b4-80bc-495f40d2483f,
 ISSN = {00219398, 15375374},
 URL = {http://www.jstor.org/stable/2352761},
 abstract = {The traditional assumption that fairness is irrelevant to economic analysis is questioned. Even profit-maximizing firms will have an incentive to act in a manner that is perceived as fair if the individuals with whom they deal are willing to resist unfair transactions and punish unfair firms at some cost to themselves. Three experiments demonstrated that willingness to enforce fairness is common. Community standards for actions affecting customers, tenants, and employees were studied in telephone surveys. The rules of fairness, some of which are not obvious, help explain some anomalous market phenomena.},
 author = {Daniel Kahneman and Jack L. Knetsch and Richard H. Thaler},
 journal = {The Journal of Business},
 number = {4},
 pages = {S285--S300},
 publisher = {University of Chicago Press},
 title = {Fairness and the Assumptions of Economics},
 urldate = {2024-02-10},
 volume = {59},
 year = {1986}
}

