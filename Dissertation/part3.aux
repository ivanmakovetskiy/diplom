\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Стратегическое поведение моделей ИИ GPT-3.5, GPT-4, GPT-4o, LLaMA2-70B и OpenChat-7b в различных эмоциональных состояниях (гнев', отвращение', страх', счастье', печаль') и нейтральном' состоянии (отсутствие эмоций) классифицируется как Кооператор'', Халявщик'', Условный кооператор'' или Нет четкой стратегии''.\relax }}{44}{figure.caption.17}\protected@file@percent }
\newlabel{fig:public_goods_emotion}{{\M@TitleReference {3.4}{Стратегическое поведение моделей ИИ GPT-3.5, GPT-4, GPT-4o, LLaMA2-70B и OpenChat-7b в различных эмоциональных состояниях (гнев', отвращение', страх', счастье', печаль') и нейтральном' состоянии (отсутствие эмоций) классифицируется как Кооператор'', Халявщик'', Условный кооператор'' или Нет четкой стратегии''.\relax }}{44}{Стратегическое поведение моделей ИИ GPT-3.5, GPT-4, GPT-4o, LLaMA2-70B и OpenChat-7b в различных эмоциональных состояниях (гнев', отвращение', страх', счастье', печаль') и нейтральном' состоянии (отсутствие эмоций) классифицируется как Кооператор'', Халявщик'', Условный кооператор'' или Нет четкой стратегии''.\relax }{figure.caption.17}{}}
